<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strava.Views.OnboardingScreen"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Carousel fullscreen -->
        <CarouselView x:Name="OnboardingCarousel"
                      ItemsSource="{Binding OnboardingItems}"
                      Loop="False"
                      CurrentItemChanged="OnCarouselPositionChanged"
                      IsSwipeEnabled="True">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Background image fullscreen -->
                        <Image Source="{Binding ImageSource}"
                               Aspect="AspectFill"
                               VerticalOptions="Fill"
                               HorizontalOptions="Fill" />

                        <!-- Gradient overlay escuro embaixo -->
                        <BoxView BackgroundColor="Black"
                                 Opacity="0.4"
                                 VerticalOptions="Fill" />

                        <!-- Texto sobre a imagem -->
                        <VerticalStackLayout VerticalOptions="End"
                                             Padding="30,0,30,120"
                                             Spacing="10">
                            <Label Text="STRAVA"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   CharacterSpacing="6"
                                   Opacity="0.8" />
                            <Label Text="{Binding Title}"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineHeight="1.15" />
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="#CCCCCC"
                                   LineHeight="1.4"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Progress dots + botões (por cima do carousel) -->
        <VerticalStackLayout VerticalOptions="End"
                             Padding="10,0,10,30"
                             Spacing="20">

            <!-- Progress dots -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Border x:Name="Dot1"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="#FC5200"
                        WidthRequest="24" HeightRequest="4"
                        StrokeThickness="0" />
                <Border x:Name="Dot2"
                        StrokeShape="RoundRectangle 2"
                        BackgroundColor="#666666"
                        WidthRequest="8" HeightRequest="4"
                        StrokeThickness="0" />
            </HorizontalStackLayout>

            <!-- Botões -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                <Label Text="Skip"
                       FontSize="15"
                       TextColor="#999999"
                       VerticalOptions="Center"
                       HorizontalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSkipClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Botão next circular -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="#FC5200"
                        HeightRequest="56" WidthRequest="56"
                        StrokeThickness="0">
                    <Label Text="→"
                           FontSize="22"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContinueClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
