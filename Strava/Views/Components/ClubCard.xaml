<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strava.Views.Components.ClubCard"
             x:Name="Root">

    <Border StrokeShape="RoundRectangle 20"
            BackgroundColor="White"
            WidthRequest="155"
            HeightRequest="210"
            Stroke="#F0F0F0"
            StrokeThickness="1"
            Margin="8,5">

        <Grid RowDefinitions="Auto, *, Auto" Padding="12">

            <!-- X button - funcional -->
            <Border StrokeShape="RoundRectangle 12"
                    HeightRequest="26" WidthRequest="26"
                    BackgroundColor="#F5F5F5"
                    StrokeThickness="0"
                    HorizontalOptions="End">
                <Label Text="✕"
                       FontSize="13" TextColor="#999"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding DismissCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding BindingContext, Source={x:Reference Root}}" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout Grid.Row="1" Spacing="4" VerticalOptions="Center">
                <!-- Club logo -->
                <Border StrokeShape="RoundRectangle 30"
                        HeightRequest="60" WidthRequest="60"
                        StrokeThickness="0" HorizontalOptions="Center"
                        BackgroundColor="#F5F5F5">
                    <Image Source="{Binding ClubLogoSource, Source={x:Reference Root}}"
                           Aspect="AspectFill" />
                </Border>

                <Label Text="{Binding ClubName, Source={x:Reference Root}}"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation" />

                <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                       FontSize="10"
                       TextColor="#888888"
                       HorizontalTextAlignment="Center"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- Join button -->
            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="34"
                    Stroke="#E6E6E6"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    Margin="0,4,0,0">
                <Label Text="Join Club"
                       TextColor="#FC5200"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding JoinCommand, Source={x:Reference Root}}"
                        CommandParameter="{Binding BindingContext, Source={x:Reference Root}}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>
