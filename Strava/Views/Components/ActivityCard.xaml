<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strava.Views.Components.ActivityCard"
             x:Name="this">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 20"
            Padding="0"
            Margin="15,0"
            Stroke="#EEEEEE"
            StrokeThickness="1">

        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding TapCommand, Source={x:Reference this}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference this}}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout BackgroundColor="White" Padding="15" Spacing="10">

            <!-- User info row -->
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border StrokeShape="RoundRectangle 20"
                        HeightRequest="42" WidthRequest="42"
                        StrokeThickness="0"
                        BackgroundColor="#F0F0F0">
                    <Image Source="{Binding UserImage, Source={x:Reference this}}"
                           Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                    <Label Text="{Binding UserName, Source={x:Reference this}}"
                           FontAttributes="Bold" FontSize="14" TextColor="Black" />
                    <Label Text="{Binding LocationDate, Source={x:Reference this}}"
                           FontSize="11" TextColor="#999" />
                </VerticalStackLayout>

                <Label Grid.Column="2" Text="•••"
                       FontSize="16" TextColor="#CCC"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Activity title + stats inline -->
            <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding ActivityTitle, Source={x:Reference this}}"
                       FontAttributes="Bold" FontSize="14" TextColor="Black"
                       VerticalOptions="Center" />

                <BoxView WidthRequest="1" HeightRequest="14"
                         Color="#E0E0E0" VerticalOptions="Center" Margin="4,0" />

                <Label Text="{Binding Stat1Label, Source={x:Reference this}}"
                       FontSize="10" TextColor="#AAA" VerticalOptions="Center" />
                <Label Text="{Binding Stat1Value, Source={x:Reference this}}"
                       FontAttributes="Bold" FontSize="13" TextColor="Black"
                       VerticalOptions="Center" />

                <BoxView WidthRequest="1" HeightRequest="14"
                         Color="#E0E0E0" VerticalOptions="Center" Margin="4,0" />

                <Label Text="{Binding Stat2Label, Source={x:Reference this}}"
                       FontSize="10" TextColor="#AAA" VerticalOptions="Center" />
                <Label Text="{Binding Stat2Value, Source={x:Reference this}}"
                       FontAttributes="Bold" FontSize="13" TextColor="Black"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Mini mapa com rota real -->
            <Border StrokeShape="RoundRectangle 14"
                    HeightRequest="180"
                    StrokeThickness="0"
                    BackgroundColor="#F5F5F5">
                <Image Source="{Binding MapImage, Source={x:Reference this}}"
                       Aspect="AspectFill" />
            </Border>

            <!-- Action icons + kudos -->
            <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                <Image Source="like_outline.png" WidthRequest="20"
                       VerticalOptions="Center" />
                <Image Grid.Column="1" Source="share_outline.png" WidthRequest="20"
                       Margin="16,0" VerticalOptions="Center" />
                <Image Grid.Column="2" Source="send_outline.png" WidthRequest="20"
                       VerticalOptions="Center" />

                <!-- Kudos avatars -->
                <HorizontalStackLayout Grid.Column="3" HorizontalOptions="End" Spacing="-8">
                    <Border StrokeShape="RoundRectangle 11"
                            HeightRequest="22" WidthRequest="22"
                            Stroke="White" StrokeThickness="2"
                            BackgroundColor="#FFE0CC">
                        <Label Text="🏃" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 11"
                            HeightRequest="22" WidthRequest="22"
                            Stroke="White" StrokeThickness="2"
                            BackgroundColor="#CCE5FF">
                        <Label Text="🚴" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 11"
                            HeightRequest="22" WidthRequest="22"
                            Stroke="White" StrokeThickness="2"
                            BackgroundColor="#D5F5E3">
                        <Label Text="🥾" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>
