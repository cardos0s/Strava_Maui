<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Strava.Views.Components.ActivityChip"
             xmlns:viewmodels="clr-namespace:Strava.ViewModels"
             xmlns:models="clr-namespace:Strava.Models"
             xmlns:components1="clr-namespace:Strava.Views.Components"
             x:Class="Strava.Views.FeedPage"
             x:DataType="viewmodels:FeedViewModel"
             BackgroundColor="#F5F5F7"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- MAIN CONTENT -->
        <CollectionView ItemsSource="{Binding Activities}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,50,0,0">

                    <!-- HEADER -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="20,0">
                        <Border StrokeShape="RoundRectangle 25"
                                HeightRequest="50" WidthRequest="50"
                                StrokeThickness="0"
                                BackgroundColor="#F0F0F0">
                            <Image Source="usain_bolt" Aspect="AspectFill" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                            <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                            <Label Text="@johnsanaarh" FontSize="12" TextColor="#999" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="bell_icon.png" WidthRequest="22" Margin="8,0"
                               VerticalOptions="Center" Opacity="0.6" />
                        <Image Grid.Column="3" Source="settings_icon.png" WidthRequest="22" Margin="8,0"
                               VerticalOptions="Center" Opacity="0.6" />
                    </Grid>

                    <!-- ACTIVITY CHIPS -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                Margin="0,10">
                        <HorizontalStackLayout Spacing="10" Padding="20,0">
                            <components:ActivityChip Text="Bike" Icon="bike_white.png" IsSelected="True"
                                TapCommand="{Binding NavigateToActivityCommand}" />
                            <components:ActivityChip Text="Run" Icon="run_gray.png" IsSelected="False"
                                TapCommand="{Binding NavigateToActivityCommand}" />
                            <components:ActivityChip Text="Hike" Icon="hike_gray.png" IsSelected="False"
                                TapCommand="{Binding NavigateToActivityCommand}" />
                            <components:ActivityChip Text="Walk" Icon="run_gray.png" IsSelected="False"
                                TapCommand="{Binding NavigateToActivityCommand}" />
                            <components:ActivityChip Text="Swim" Icon="run_gray.png" IsSelected="False"
                                TapCommand="{Binding NavigateToActivityCommand}" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- WELCOME -->
                    <Label FontSize="30" Padding="20,0" Margin="0,10">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Welcome, " TextColor="Black" />
                                <Span Text="{Binding UserName}" FontAttributes="Bold" TextColor="Black" />
                                <Span Text="!" FontAttributes="Bold" TextColor="Black" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- CLUB SUGGESTIONS -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                Margin="0,5">
                        <HorizontalStackLayout Spacing="0"
                                               Padding="12,0"
                                               BindableLayout.ItemsSource="{Binding ClubSuggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ClubSuggestionModel">
                                    <components1:ClubCard
                                        ClubName="{Binding ClubName}"
                                        Subtitle="{Binding Subtitle}"
                                        ClubLogoSource="{Binding ClubLogoSource}"
                                        DismissCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FeedViewModel}}, Path=RemoveClubCommand}"
                                        JoinCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FeedViewModel}}, Path=JoinClubCommand}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- RECENT ACTIVITY -->
                    <Label Text="Recent Activity"
                           FontAttributes="Bold"
                           FontSize="18"
                           Margin="20,15,20,5"
                           TextColor="Black" />

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ActivityCardModel">
                    <components1:ActivityCard
                        UserName="{Binding UserName}"
                        LocationDate="{Binding LocationDate}"
                        ActivityTitle="{Binding Title}"
                        Stat1Label="{Binding Stat1Label}"
                        Stat1Value="{Binding Stat1Value}"
                        Stat2Label="{Binding Stat2Label}"
                        Stat2Value="{Binding Stat2Value}"
                        MapImage="{Binding MapImage}"
                        UserImage="{Binding UserImage}"
                        TapCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FeedViewModel}}, Path=OpenActivityCommand}"
                        CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="#F5F5F7" />
            </CollectionView.Footer>

        </CollectionView>

        <!-- TAB BAR -->
        <components1:CustomTabBar
            VerticalOptions="End"
            ZIndex="10" />

        <!-- SIDE MENU -->
        <components1:Sidemenu
            x:Name="Sidemenu"
            ZIndex="20" />
    </Grid>
</ContentPage>
