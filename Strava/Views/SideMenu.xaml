<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strava.Views.Components.Sidemenu"
             x:Name="Root"
             BackgroundColor="Transparent"
             IsVisible="False"
             InputTransparent="True">

    <Grid>
        <!-- Overlay escuro -->
        <BoxView x:Name="Overlay"
                 BackgroundColor="Black"
                 Opacity="0"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Painel lateral -->
        <Border x:Name="MenuPanel"
                BackgroundColor="White"
                WidthRequest="300"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                StrokeThickness="0"
                TranslationX="-300"
                StrokeShape="RoundRectangle 0,20,0,20">

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0" Padding="0">

                    <!-- PROFILE SECTION -->
                    <VerticalStackLayout Spacing="8"
                                         Padding="24,60,24,24"
                                         BackgroundColor="White">

                        <!-- Avatar com borda laranja -->
                        <Border StrokeShape="RoundRectangle 40"
                                HeightRequest="80" WidthRequest="80"
                                Stroke="#FC5200"
                                StrokeThickness="3"
                                HorizontalOptions="Center"
                                BackgroundColor="#F0F0F0">
                            <Image Source="usain_bolt" Aspect="AspectFill" />
                        </Border>

                        <Label Text="Ver Perfil"
                               FontSize="11"
                               TextColor="#FC5200"
                               HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Nome -->
                        <Label Text="John Sanaarh"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"
                               Margin="0,4,0,0" />

                        <!-- Stats -->
                        <Label FontSize="13"
                               TextColor="#888"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="306" FontAttributes="Bold" TextColor="#333" />
                                    <Span Text=" Seguidores" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="13"
                               TextColor="#888"
                               HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="234" FontAttributes="Bold" TextColor="#333" />
                                    <Span Text=" Seguindo" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label FontSize="13"
                               TextColor="#888"
                               HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="2089" FontAttributes="Bold" TextColor="#333" />
                                    <Span Text=" Kudos" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="24,0" />

                    <!-- MENU ITEMS -->
                    <VerticalStackLayout Spacing="0" Padding="0,8">

                        <!-- Progresso -->
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="24,16">
                            <Label Text="Progresso"
                                   FontSize="16"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="›"
                                   FontSize="18" TextColor="#CCC" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProgressTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Atividades -->
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="24,16">
                            <Label Text="Atividades"
                                   FontSize="16"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="›"
                                   FontSize="18" TextColor="#CCC" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnActivitiesTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <!-- Conta -->
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="24,16">
                            <Label Text="Conta"
                                   FontSize="16"
                                   TextColor="Black" />
                            <Label Grid.Column="1" Text="›"
                                   FontSize="18" TextColor="#CCC" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAccountTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" Color="#F0F0F0" Margin="24,0" />

                    <!-- BOTTOM SECTION -->
                    <VerticalStackLayout Spacing="0" Padding="24,20" VerticalOptions="End">

                        <!-- Seja Premium -->
                        <HorizontalStackLayout Spacing="8" Margin="0,0,0,16">
                            <Label Text="🌟" FontSize="18" VerticalOptions="Center" />
                            <Label Text="Seja Premium"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPremiumTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>

                        <!-- Logoff -->
                        <Label Text="Logoff"
                               FontSize="15"
                               TextColor="#888"
                               Margin="0,0,0,20">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoffTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Member since -->
                        <Label Text="Membro Strava desde 2013"
                               FontSize="11"
                               TextColor="#BBB" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
